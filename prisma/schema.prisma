generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            BigInt         @id @default(autoincrement())
  companyId     BigInt         @map("company_id")
  name          String         @db.VarChar(120)
  email         String         @unique @db.VarChar(255)
  passwordHash  String         @map("password_hash")
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamp(6)
  lastLogin     DateTime?      @map("last_login") @db.Timestamp(6)
  company       Company        @relation(fields: [companyId], references: [id])
  refreshTokens RefreshToken[]
  userRoles     UserRole[]

  @@index([companyId])
  @@map("users")
}

model Company {
  id        BigInt   @id @default(autoincrement())
  name      String   @db.VarChar(120)
  cnpj      String   @unique @db.VarChar(18)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  users     User[]

  @@map("companies")
}

model Measure {
  id           BigInt    @id @default(autoincrement())
  name         String    @unique @db.VarChar(80)
  abbreviation String    @unique @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime  @default(now()) @map("updated_at") @db.Timestamp(6)
  products     Product[]

  @@map("measure")
}

model Product {
  id          BigInt   @id @default(autoincrement())
  name        String   @db.VarChar(160)
  measureId   BigInt   @map("measure_id")
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamp(6)
  measure     Measure  @relation(fields: [measureId], references: [id])

  @@index([measureId])
  @@map("products")
}

model RefreshToken {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at") @db.Timestamp(6)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  ipAddress String?  @map("ip_address") @db.VarChar(50)
  userAgent String?  @map("user_agent")
  user      User     @relation(fields: [userId], references: [id])

  @@map("refresh_tokens")
}

model Role {
  id        BigInt     @id @default(autoincrement())
  name      String     @unique @db.VarChar(50)
  userRoles UserRole[]

  @@map("roles")
}

model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}
